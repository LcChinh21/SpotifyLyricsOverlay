<Window x:Class="SpotifyLyricsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Spotify Lyrics Overlay"
        Width="800" Height="440"
        MinWidth="400" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Control Styles -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#35000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Spotify Mix UI, Segoe UI, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#75000000"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#70FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundControlBtn" TargetType="Button">
            <Setter Property="Background" Value="#35000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#75000000"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#70FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Button Style -->
        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatchBorder" Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#80FFFFFF" BorderThickness="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="swatchBorder" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContainer">
        <!-- Main Card Border (Transparent by default for pure floating text, or toggleable to glass) -->
        <Border x:Name="CardBorder"
                CornerRadius="18"
                Background="#01000000"
                BorderBrush="Transparent"
                BorderThickness="0"
                Margin="6">

            <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <!-- Header (Song Info & Player bar) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spotify-style Lyrics Area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP HEADER: [ Thumbnail ] Title/Artist [ Progress Bar ] [ Toolbar ] -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Thumbnail -->
                        <ColumnDefinition Width="*"/>    <!-- Title, Artist & Progress Bar -->
                        <ColumnDefinition Width="Auto"/> <!-- Hover Toolbar / Unlock Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Album Art Thumbnail [  ] -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Background="#33000000" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.8"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            <Image x:Name="ImgThumbnail" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Song Info and Progress Bar -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title Row: Official Spotify Mix UI Title Font -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock x:Name="TxtSongTitle"
                                       Text="Đang chờ Spotify..."
                                       FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI Title, Segoe UI Variable Display, Segoe UI, Arial, sans-serif"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.95"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="TxtPlayingDot" Text=" ●" FontSize="11" Foreground="#1DB954" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- Artist & Time Row: Official Spotify Mix UI Font -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
                            <TextBlock x:Name="TxtArtist"
                                       Text="Mở nhạc để hiện lyrics Spotify"
                                       FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI, Segoe UI, Arial, sans-serif"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#D5FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="280">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="315" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text=" • " FontSize="11" Foreground="#99FFFFFF" Margin="4,0"/>
                            <TextBlock x:Name="TxtTime"
                                       Text="00:00 / 00:00"
                                       FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI, Segoe UI, Arial, sans-serif"
                                       FontSize="11"
                                       Foreground="#D5FFFFFF"
                                       VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="315" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <!-- Progress Bar (Clickable) -->
                        <Grid x:Name="ProgressBarContainer" Grid.Row="2" Height="4" Margin="0,2,0,0" Cursor="Hand" MouseLeftButtonDown="ProgressBarContainer_MouseLeftButtonDown">
                            <Border Background="#45000000" CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ProgressBarFill" Background="#FFFFFF" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </Grid>

                    <!-- HOVER TOOLBAR (Visible when Unlocked) -->
                    <StackPanel x:Name="ToolbarPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play/Pause -->
                        <Button Style="{StaticResource RoundControlBtn}" Click="BtnPlayPause_Click" ToolTip="Phát / Tạm dừng">
                            <TextBlock x:Name="TxtPlayPauseIcon" Text="⏸" FontSize="11"/>
                        </Button>
                        <!-- Next Song -->
                        <Button Style="{StaticResource RoundControlBtn}" Click="BtnNext_Click" ToolTip="Bài tiếp theo">
                            <TextBlock Text="⏭" FontSize="10"/>
                        </Button>
                        <!-- Customize / Settings Button -->
                        <Button Style="{StaticResource IconButton}" Click="BtnCustomize_Click" ToolTip="Tùy chỉnh cỡ chữ &amp; màu sắc">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨 " FontSize="10"/>
                                <TextBlock Text="Tùy chỉnh" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <!-- Font Size Down -->
                        <Button Style="{StaticResource RoundControlBtn}" Click="BtnFontDown_Click" ToolTip="Giảm cỡ chữ">
                            <TextBlock Text="A-" FontSize="10" FontWeight="Bold"/>
                        </Button>
                        <!-- Font Size Up -->
                        <Button Style="{StaticResource RoundControlBtn}" Click="BtnFontUp_Click" ToolTip="Tăng cỡ chữ">
                            <TextBlock Text="A+" FontSize="10" FontWeight="Bold"/>
                        </Button>
                        <!-- Sync Offset Minus -->
                        <Button Style="{StaticResource IconButton}" Click="BtnSyncMinus_Click" ToolTip="Chỉnh lời sớm hơn 0.5s">
                            <TextBlock Text="-0.5s" FontSize="10"/>
                        </Button>
                        <!-- Sync Offset Plus -->
                        <Button Style="{StaticResource IconButton}" Click="BtnSyncPlus_Click" ToolTip="Chỉnh lời trễ hơn 0.5s">
                            <TextBlock Text="+0.5s" FontSize="10"/>
                        </Button>
                        <!-- Glass / Transparent toggle -->
                        <Button Style="{StaticResource RoundControlBtn}" Click="BtnGlass_Click" ToolTip="Bật/Tắt nền kính mờ">
                            <TextBlock x:Name="TxtGlassIcon" Text="✨" FontSize="11"/>
                        </Button>
                        <!-- Lock (Click-Through) -->
                        <Button x:Name="BtnLock" Style="{StaticResource RoundControlBtn}" Click="BtnLock_Click" ToolTip="Khóa ghim (Xuyên chuột) - Ẩn nút">
                            <TextBlock x:Name="TxtLockIcon" Text="🔒" FontSize="11"/>
                        </Button>
                        <!-- Close Button -->
                        <Button Style="{StaticResource RoundControlBtn}" Click="BtnClose_Click" ToolTip="Đóng ứng dụng">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <!-- FLOATING UNLOCK BUTTON (Appears when hovering while locked!) -->
                    <Border x:Name="FloatingUnlockBorder"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Background="#D015151B"
                            BorderBrush="#60FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,5"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="BtnFloatingUnlock_Click">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.8"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔓 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Mở khóa" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SPOTIFY-STYLE LYRICS SCROLLING AREA -->
                <Grid Grid.Row="1" x:Name="LyricsAreaGrid">
                    <!-- Status / Waiting Message -->
                    <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Visibility="Visible">
                        <TextBlock x:Name="TxtStatus"
                                   Text="Chờ bài hát từ Spotify..."
                                   FontSize="22"
                                   FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI Title, Segoe UI, Arial, sans-serif"
                                   Foreground="#80FFFFFF"
                                   TextAlignment="Left">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Phát nhạc trên Spotify • Nhấn 🔒 hoặc Ctrl+Shift+L để khóa xuyên chuột"
                                   FontSize="12"
                                   FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI, Segoe UI, sans-serif"
                                   Foreground="#60FFFFFF"
                                   Margin="0,8,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="315" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- SPOTIFY LYRICS SCROLLVIEWER -->
                    <ScrollViewer x:Name="LyricsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="LyricsListPanel"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch"
                                    Margin="4,20,4,160"/>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS & CUSTOMIZATION FLYOUT PANEL -->
                <Border x:Name="SettingsFlyout"
                        Grid.Row="0" Grid.RowSpan="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="330" Margin="0, 48, 4, 0"
                        Background="#EE141419"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="⚙️ Tùy chỉnh giao diện" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" FontFamily="pack://application:,,,/Fonts/#Spotify Mix UI Title, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource RoundControlBtn}" Width="24" Height="24" HorizontalAlignment="Right" Click="BtnCloseSettings_Click">
                                <TextBlock Text="✕" FontSize="10"/>
                            </Button>
                        </Grid>

                        <!-- SECTION 1: CỠ CHỮ -->
                        <TextBlock Text="CỠ CHỮ (FONT SIZE)" FontSize="10" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderFontSize" Minimum="18" Maximum="48" SmallChange="1" LargeChange="2" Value="28" ValueChanged="SliderFontSize_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFontSizePreview" Grid.Column="1" Text="28 pt" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                        </Grid>

                        <!-- Presets for font size -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource IconButton}" Content="Nhỏ (22)" Click="BtnPresetFont_Click" Tag="22"/>
                            <Button Style="{StaticResource IconButton}" Content="Vừa (28)" Click="BtnPresetFont_Click" Tag="28"/>
                            <Button Style="{StaticResource IconButton}" Content="Lớn (34)" Click="BtnPresetFont_Click" Tag="34"/>
                            <Button Style="{StaticResource IconButton}" Content="To (42)" Click="BtnPresetFont_Click" Tag="42"/>
                        </StackPanel>

                        <Separator Background="#25FFFFFF" Margin="0,0,0,12"/>

                        <!-- SECTION 2: MÀU DÒNG ĐANG HÁT (ACTIVE) -->
                        <TextBlock Text="MÀU CÂU ĐANG HÁT (ACTIVE)" FontSize="10" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFFFFF" Click="BtnSwatchActive_Click" Tag="#FFFFFF" ToolTip="Trắng Spotify"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#1DB954" Click="BtnSwatchActive_Click" Tag="#1DB954" ToolTip="Xanh Spotify"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#00F0FF" Click="BtnSwatchActive_Click" Tag="#00F0FF" ToolTip="Xanh Cyan Neon"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#C084FC" Click="BtnSwatchActive_Click" Tag="#C084FC" ToolTip="Tím Lavender"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#FF2A85" Click="BtnSwatchActive_Click" Tag="#FF2A85" ToolTip="Hồng Neon"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#FFD166" Click="BtnSwatchActive_Click" Tag="#FFD166" ToolTip="Vàng Sunset"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#FF7A00" Click="BtnSwatchActive_Click" Tag="#FF7A00" ToolTip="Cam Vibrant"/>
                            <Button Style="{StaticResource ColorSwatchBtn}" Background="#FF4B4B" Click="BtnSwatchActive_Click" Tag="#FF4B4B" ToolTip="Đỏ San Hô"/>
                        </WrapPanel>

                        <!-- Custom Hex Color for Active -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã màu:" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtHexColor" Grid.Column="1" Text="#FFFFFF" Background="#30000000" Foreground="#FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="6,3" VerticalAlignment="Center" FontFamily="Consolas"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="Áp dụng" Click="BtnApplyHex_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <Separator Background="#25FFFFFF" Margin="0,0,0,12"/>

                        <!-- SECTION 3: ĐỘ MỜ CÁC CÂU CÒN LẠI (OPACITY) -->
                        <TextBlock Text="ĐỘ MỜ CÁC CÂU CÒN LẠI" FontSize="10" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderOpacity" Minimum="0.15" Maximum="0.80" SmallChange="0.05" LargeChange="0.10" Value="0.40" ValueChanged="SliderOpacity_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOpacityPreview" Grid.Column="1" Text="40%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
                        </Grid>

                        <!-- Bottom Close Button -->
                        <Button Style="{StaticResource IconButton}" Content="Đóng bảng tùy chỉnh" HorizontalAlignment="Stretch" Padding="0,6" Click="BtnCloseSettings_Click"/>
                    </StackPanel>
                </Border>

                <!-- TOAST NOTIFICATION PILL -->
                <Border x:Name="ToastBorder" Grid.Row="0" Grid.RowSpan="2"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Background="#E0000000" CornerRadius="12" Padding="14,6" Margin="0,0,0,10"
                        BorderBrush="#40FFFFFF" BorderThickness="1"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtToast" Text="Đã mở khóa" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                </Border>

            </Grid>
        </Border>

        <!-- Resize Grip / Corner Icon -->
        <Border x:Name="ResizeGripBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18" Margin="0,0,6,6" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown">
            <Path Data="M 14 18 L 18 14 M 10 18 L 18 10 M 6 18 L 18 6" Stroke="#80FFFFFF" StrokeThickness="1.5">
                <Path.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
                </Path.Effect>
            </Path>
        </Border>
    </Grid>
</Window>
